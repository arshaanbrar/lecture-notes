# Copy this file to `.env` for local development:   cp .env.example .env
# On Render, add the same names under your service → Environment instead (never commit .env).

# ⚠️ PASTE YOUR KEY: Groq API key from https://console.groq.com/keys (starts with "gsk_")
GROQ_API_KEY=

# ⚠️ PASTE YOUR KEY: Notion internal integration secret (starts with "ntn_")
NOTION_TOKEN=

# ⚠️ PASTE YOUR PAGE: URL (or ID) of the Notion page new notes are created inside
NOTION_PARENT_PAGE_ID=

# Optional: a password everyone must enter to use the site (protects your free quotas). Leave blank for none.
APP_PASSWORD=

# --- Optional tuning (defaults are fine) ---
# groq = Whisper hosted by Groq (recommended). local = run Whisper on this machine (needs requirements-local-whisper.txt)
TRANSCRIBE_BACKEND=groq
# LOCAL_WHISPER_MODEL=base
# GROQ_MODEL=llama-3.3-70b-versatile,openai/gpt-oss-120b   (tried in order; first available wins)
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# MAX_UPLOAD_MB=300
